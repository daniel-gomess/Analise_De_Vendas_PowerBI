	measure Valor_Total_MoM_Texto = ```
			
			VAR vValor = [Valor_Total_MoM_%]
			
			VAR vSeta =
			    SWITCH(
			        TRUE(),
			        vValor > 0, UNICHAR(9650),   -- ▲
			        vValor < 0, UNICHAR(9660),   -- ▼
			        UNICHAR(8213)                -- ―
			    )
			
			RETURN
			IF(
			    ISBLANK(vValor),
			    BLANK(),
			    vSeta & " " &
			    FORMAT(vValor, "0.00%") &
			    " vs mês anterior"
			)
			
			```
		displayFolder: 5. Dinâmicas
		lineageTag: 42f7abab-c3eb-4ea9-8e2a-4e5400534c6a

