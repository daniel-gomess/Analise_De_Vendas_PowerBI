	measure Regressao_Linear =
			
			VAR vSlope = SELECTEDVALUE(Regressao[Slope1])
			VAR vIntercept = SELECTEDVALUE(Regressao[Intercept])
			VAR vX = SELECTEDVALUE(d_Calendario[Data])
			VAR vY = vX * vSlope + vIntercept
			
			RETURN
			
			vY
		displayFolder: 2. Analise_Temporal
		lineageTag: 5b52efbb-e55f-4bc8-9ce5-1b548810fcc6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Previsao = ```
			
			VAR vDataUltimaVenda = 
			CALCULATE(
			    MAX(f_Vendas[Data]),
			    ALL(d_Calendario[Data])
			)
			
			VAR vEixo = MIN(d_Calendario[Data])
			
			VAR vValor = 
			AVERAGEX(
			    ALL(
			        d_Calendario[Mes_Nome],
			        d_Calendario[Mes],
			        d_Calendario[Ano]
			    ),
			    [Valor_Total]
			)
			
			RETURN
			
			IF(
			    vEixo > vDataUltimaVenda,
			        vValor,
			        BLANK()
			)
			
			```
		displayFolder: 2. Analise_Temporal
		lineageTag: a2163383-728c-4cb7-b804-b71b42cc0062

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Data Selecionada' = ```
			
			VAR vAno =
			    SELECTEDVALUE(d_Calendario[Ano])
			
			VAR vTabelaMeses =
			    SUMMARIZE(
			        d_Calendario,
			        d_Calendario[Mes],
			        d_Calendario[Mes_Nome]
			    )
			
			VAR vQtdMesesSelecionados =
			    COUNTROWS(vTabelaMeses)
			
			VAR vListaMeses =
			    CONCATENATEX(
			        vTabelaMeses,
			        d_Calendario[Mes_Nome],
			        ", ",
			        d_Calendario[Mes]
			    )
			
			RETURN
			IF(
			    vQtdMesesSelecionados = 12,
			    "no ano de " & vAno,
			    "no(s) mês(es) de " & vListaMeses & " de " & vAno
			)
			
			```
		displayFolder: 1. Principal
		lineageTag: 2627afcb-ac43-4a43-9927-33606627ed12

