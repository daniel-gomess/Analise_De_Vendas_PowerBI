table d_Medidas
	lineageTag: 0a5ea071-d8a1-4cc2-bc94-0d1867f0708b

	measure Valor_Total = SUM(f_Vendas[Valor])
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 1. Principal
		lineageTag: 9abf1e68-1d23-4261-bfec-9ba4dacedbdb

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure Valor_Total_Mes_Anterior =
			
			CALCULATE(
			    [Valor_Total],
			    DATEADD(
			        d_calendario[Data],
			        -1,
			        MONTH
			    )
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 2. Analise_Temporal
		lineageTag: 1f7ce940-1712-4c6e-a3f2-113c1bc74fe1

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure Qtde_Parcelas = SUM(f_Vendas[Nº Vezes])
		formatString: #,0
		displayFolder: 1. Principal
		lineageTag: 1ac7f740-74be-495d-9e85-b2bf32b42c72

	measure Var_%_Valor_Total_Mes = ```
			
			VAR valorAtual = [Valor_Total]
			VAR valorAnterior = [Valor_Total_Mes_Anterior]
			RETURN
			IF(
			    NOT ISBLANK(valorAnterior),
			    DIVIDE(valorAtual - valorAnterior, valorAnterior)
			)
			
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 2. Analise_Temporal
		lineageTag: 9cc7b332-39e8-4e0c-9137-ca8b157ca529

	measure Valor_Total_YTD = ```
			
			TOTALYTD(
			    [Valor_Total],
			    d_calendario[Data]
			)
			
			```
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 2. Analise_Temporal
		lineageTag: a1f5d26d-3ac1-4b9c-8242-c8239e0a2ead

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure Media_Movel_3M = ```
			
			AVERAGEX(
			    DATESINPERIOD(
			        d_calendario[Data],
			        MAX(d_calendario[Data]),
			        -3,
			        MONTH
			    ),
			    [Valor_Total]
			)
			
			```
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 2. Analise_Temporal
		lineageTag: f5655650-2338-4113-96ef-a819381de73d

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure Ticket_Medio = ```
			
			DIVIDE(
			    [Valor_Total],
			    COUNTROWS(f_vendas)
			)
			
			```
		formatString: #,0.00
		displayFolder: 2. Analise_Temporal
		lineageTag: 21dea777-69e7-499a-886a-cf3d859a3001

	measure Valor_Sem_Desconto = ```
			
			SUMX(
			    f_vendas,
			    DIVIDE(
			        f_vendas[Valor],
			        1 - f_vendas[Desconto]
			    )
			)
			
			```
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 1. Principal
		lineageTag: 3925cf14-e9fa-4b35-bd19-6fdeeb8ca49d

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure Impacto_%_Desconto = ```
			
			DIVIDE(
			    [Valor_Desconto],
			    [Valor_Sem_Desconto]
			)
			
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 1. Principal
		lineageTag: 56a5d7cb-492c-4079-bd58-d2128de83dde

	measure Valor_Desconto = [Valor_Sem_Desconto] - [Valor_Total]
